# Shared token for write operations (POST /api/cards, POST /api/uploads)
# 使用 python -c "import secrets; print(secrets.token_hex(32))" 生成
API_TOKEN=change-me-to-a-random-token

# Comma-separated CORS origins allowed to call this API (frontend origin)
ALLOWED_ORIGINS=http://localhost:5173

# --- JWT Authentication ---
# 使用 python -c "import secrets; print(secrets.token_hex(32))" 生成，至少 32 bytes
JWT_SECRET=change-me-to-a-random-secret
JWT_EXPIRY_MINUTES=30

# --- Initial Admin Account ---
# 首次啟動時若 ADMIN_PASSWORD 不是 'changeme'，會自動建立 admin 帳號
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
