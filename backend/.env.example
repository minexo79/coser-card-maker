# Comma-separated CORS origins allowed to call this API (frontend origin)
ALLOWED_ORIGINS=http://localhost:5173

# --- JWT Authentication ---
# 使用 python -c "import secrets; print(secrets.token_hex(32))" 生成，至少 32 bytes
JWT_SECRET=change-me-to-a-random-secret
JWT_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_DAYS=7

# --- Initial Admin Account ---
# 首次啟動時若 ADMIN_PASSWORD 不是 'changeme'，會自動建立 admin 帳號
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# --- MongoDB ---
# 資料儲存位置。留空(預設)會改用記憶體 mongomock，方便本機開發/測試。
# 正式環境請設定為實際連線字串，例如：
#   MONGODB_URI=mongodb://user:pass@localhost:27017
MONGODB_URI=
MONGODB_DB_NAME=ccm

# --- Cloudflare R2 / Amazon S3（底圖物件儲存） ---
# 全部留空時退回本機磁碟（UPLOADS_DIR，預設 ./uploads），方便本機開發/測試。
# 正式環境請填寫 R2 的 S3 API 憑證（R2 為 S3 相容，亦適用其他 S3 endpoint）。
#   R2_ACCOUNT_ID=                # R2 帳戶 ID，用於自動推導 endpoint
#   R2_ACCESS_KEY_ID=             # R2 S3 API Access Key
#   R2_SECRET_ACCESS_KEY=         # R2 S3 API Secret Key
#   R2_BUCKET_NAME=               # R2 Bucket 名稱
#   R2_REGION=auto                # Region（R2 用 auto）
#   R2_ENDPOINT_URL=              # 自訂 endpoint；留空時依 R2_ACCOUNT_ID 推導
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_REGION=auto
R2_ENDPOINT_URL=
