# Shared token for write operations (POST /api/cards, POST /api/uploads)
# 與 backend/.env 的 API_TOKEN 保持一致；此值會被打包進前端 JS bundle，請勿用於生產環境
VITE_API_TOKEN=change-me-to-match-backend
# 後端 API 位址（前後端分離部署）
# 本機開發：
VITE_API_BASE_URL=http://localhost:8000,http://127.0.0.1:8000
# 生產環境範例：
# VITE_API_BASE_URL=https://api.your-domain.com
