{
  "services": {
    "my_frontend": {
      "root": "frontend/",
      "rewrites": [
        { "source": "/((?!.*\\.[a-zA-Z0-9]+$).*)", "destination": "/index.html" }
      ]
    },
    "my_backend": {
      "root": "backend/",
      "entrypoint": "app.main:app"
    }
  },
  "rewrites": [
    { "source": "/uploads/(.*)", "destination": { "service": "my_backend" } },
    { "source": "/api/(.*)", "destination": { "service": "my_backend" } },
    { "source": "/(.*)", "destination": { "service": "my_frontend" } }
  ]
}